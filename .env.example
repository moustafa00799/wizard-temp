# CDKS — Local Staging only
# Copy to .env.local and replace both placeholder secrets locally.
# Never commit .env.local or paste these values into chat.

CDKS_LOCAL_AUTH_ENABLED=true
CDKS_LOCAL_AUTH_ACCESS_CODE=replace-with-a-local-access-code-at-least-12-chars
CDKS_LOCAL_AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
CDKS_LOCAL_AUTH_USER_ID=local-owner
CDKS_LOCAL_AUTH_WORKSPACE_ID=workspace-local-cdks
CDKS_LOCAL_AUTH_ROLE=owner
CDKS_DEFAULT_WORKSPACE_ID=workspace-local-cdks
CDKS_DEFAULT_WORKSPACE_USER_ID=local-owner

# Keep advisory AI optional and non-production.
AI_LIVE_ENABLED=false
AI_PROVIDER_MODE=nonprod
AI_DATA_POLICY=sanitized_wizard_only

# No provider write scopes are enabled by this template.
